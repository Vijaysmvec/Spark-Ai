# ==============================================================================
# SPARK AI — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your keys.
# Never expose GEMINI_API_KEY or backend secrets in NEXT_PUBLIC_* variables.
# ==============================================================================

# --- Backend (FastAPI + LangGraph + Gemini 2.5 Flash) ---
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_project_number_here
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./spark_ai.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SPARK_API_TOKEN=spark-dev-token-2026

# --- Frontend (Next.js App Router) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Firebase Authentication (Paste from Firebase Console -> Project Settings) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
